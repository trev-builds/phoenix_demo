ANTHROPIC_API_KEY=your-key
# Phoenix Cloud (get these from your Phoenix space settings)
PHOENIX_API_KEY=your-phoenix-key
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
# Only set these when using the synthetic data:
AGENT_TODAY=2026-09-28
# Cheap model makes the tools-vs-LLM-math gap easy to see
AGENT_MODEL=claude-haiku-4-5-20251001
# Set to km if your Garmin account is metric
DISTANCE_UNIT=mi
